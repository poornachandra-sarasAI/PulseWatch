POSTGRES_DB=pulsewatch
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=pulsewatch

# Used by the backend when running locally (not via Docker Compose)
DATABASE_URL=postgresql+psycopg://pulsewatch:pulsewatch@localhost:5432/pulsewatch

# Used by the Next.js frontend (must be reachable from the browser)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
